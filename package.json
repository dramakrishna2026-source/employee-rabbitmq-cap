{
  "name": "employee-rabbitmq-cap",
  "version": "1.0.0",
  "private": true,
  "description": "SAP CAP Employee OData service with RabbitMQ (CloudAMQP) producer and consumer",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "consumer": "node consumer.js"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.16.0",
    "amqplib": "^0.10.8",
    "dotenv": "^16.4.7",
    "express": "^5"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.2.1"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked"
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/employee.db"
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
